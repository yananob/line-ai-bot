parameters:
    level: 5
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - vendor (?)
            - node_modules (?)
            - templates_c (?)
            - _deploy (?)
            - _template (?)
            - _cf-common (?)

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            identifier: method.alreadyNarrowedType
